#!/usr/bin/env sh
# Allinone launcher for macOS / Linux.  Usage: ./allinone [command]
DIR="$(cd "$(dirname "$0")" && pwd)"
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" "$DIR/allinone.py" "$@"
  fi
done
echo "[Allinone] Python 3.10+ is required." >&2
exit 1
