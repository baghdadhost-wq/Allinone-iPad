# ============================================================================
#  خيارات FreeLLMAPI الإضافية (متغيرات البيئة الأصلية الخاصة به)
#  تُمرَّر إلى FreeLLMAPI عند تشغيله من Allinone. القائمة الكاملة:
#  https://github.com/tashfeenahmed/freellmapi/blob/main/docs/en/env/01-variables.md
#
#  يتولى Allinone ضبط هذه المتغيرات تلقائياً، فلا تضعها هنا:
#    PORT  HOST  NODE_ENV  ENCRYPTION_KEY  FREEAPI_DB_PATH  FREEAPI_ENV_PATH
#  لا تضع أسراراً في هذا الملف لأنه محفوظ في git. الأسرار مكانها data/secrets.json
# ============================================================================

# ضغط السياق قبل الإرسال لتوفير الرموز (tokens): off | lossless | standard | aggressive
# FREELLMAPI_COMPRESSION=lossless

# النموذج الافتراضي لأداة ask_freellmapi الخاصة بـ MCP
# MCP_INFERENCE_DEFAULT_MODEL=auto

# تعطيل فحص التحديثات
# FREELLMAPI_UPDATE_CHECK=off
