# ============================================================================
#  خيارات OmniRoute الإضافية (متغيرات البيئة الأصلية الخاصة به)
#  تُمرَّر إلى OmniRoute عند تشغيله من Allinone. القائمة الكاملة:
#  https://github.com/diegosouzapw/OmniRoute/blob/main/docs/reference/ENVIRONMENT.md
#
#  يتولى Allinone ضبط هذه المتغيرات تلقائياً، فلا تضعها هنا:
#    PORT  DATA_DIR  OMNIROUTE_SERVER_HOST  INITIAL_PASSWORD
#  (لتغيير المنفذ عدّل "port" في config/allinone.jsonc)
#  لا تضع أسراراً في هذا الملف لأنه محفوظ في git. الأسرار مكانها data/secrets.json
# ============================================================================

# اطلب مفتاح API من كل أداة تستخدم البوابة. إن فعّلته فاحفظ المفتاح بالأمر: allinone key omniroute <KEY>
# REQUIRE_API_KEY=true

# حجم ذاكرة Node لـ OmniRoute بالميغابايت (الافتراضي حوالي 35% من ذاكرة الجهاز، بين 512 و4096)
# OMNIROUTE_MEMORY_MB=4096

# إظهار نماذج غير Claude داخل قائمة /model في Claude Code (بأسماء claude/...)
# EXPOSE_CC_DISCOVERY_ALIASES=true
