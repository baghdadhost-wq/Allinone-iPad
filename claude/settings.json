{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "mcp__allinone"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{python}}",
            "args": ["{{root}}/claude/hooks/session_start.py"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
